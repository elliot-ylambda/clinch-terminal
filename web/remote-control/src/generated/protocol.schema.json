{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanionProtocolSchema",
  "description": "Schema root used by the checked-in JSON Schema and TypeScript generator.",
  "type": "object",
  "properties": {
    "auth_challenge": {
      "$ref": "#/$defs/AuthChallenge"
    },
    "auth_challenge_request": {
      "$ref": "#/$defs/AuthChallengeRequest"
    },
    "authenticate": {
      "$ref": "#/$defs/Authenticate"
    },
    "client_envelope": {
      "$ref": "#/$defs/ClientEnvelope"
    },
    "pairing_claim_receipt": {
      "$ref": "#/$defs/PairingClaimReceipt"
    },
    "pairing_claim_request": {
      "$ref": "#/$defs/PairingClaimRequest"
    },
    "pairing_invitation": {
      "$ref": "#/$defs/PairingInvitation"
    },
    "pairing_status": {
      "$ref": "#/$defs/PairingStatus"
    },
    "pairing_status_request": {
      "$ref": "#/$defs/PairingStatusRequest"
    },
    "server_envelope": {
      "$ref": "#/$defs/ServerEnvelope"
    }
  },
  "required": [
    "client_envelope",
    "server_envelope",
    "pairing_claim_request",
    "pairing_claim_receipt",
    "pairing_status_request",
    "pairing_status",
    "auth_challenge_request",
    "auth_challenge",
    "authenticate",
    "pairing_invitation"
  ],
  "$defs": {
    "AcquireWriterLease": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "workspace_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "workspace_revision"
      ]
    },
    "AgentProvider": {
      "type": "string",
      "enum": [
        "claude_code",
        "codex"
      ]
    },
    "AgentState": {
      "type": "string",
      "enum": [
        "working",
        "done",
        "needs_attention",
        "idle",
        "rate_limited",
        "unknown"
      ]
    },
    "AuthChallenge": {
      "type": "object",
      "properties": {
        "challenge": {
          "type": "string"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "device_id",
        "challenge",
        "expires_at"
      ]
    },
    "AuthChallengeRequest": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "device_id"
      ]
    },
    "Authenticate": {
      "type": "object",
      "properties": {
        "challenge_id": {
          "type": "string",
          "format": "uuid"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "last_seen_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "signature": {
          "description": "Base64-encoded IEEE P1363 ECDSA P-256 signature (r || s).",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "challenge_id",
        "signature",
        "last_seen_sequence"
      ]
    },
    "Authenticated": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceSummary"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "replayed_from_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "session_id",
        "device",
        "expires_at"
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "view",
        "control",
        "create_session",
        "upload"
      ]
    },
    "ClientEnvelope": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/ClientMessage"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "version",
        "request_id",
        "payload"
      ]
    },
    "ClientMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ping"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "request_snapshot"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/SelectTarget"
            },
            "type": {
              "type": "string",
              "const": "select_target"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/AcquireWriterLease"
            },
            "type": {
              "type": "string",
              "const": "acquire_writer_lease"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ReleaseWriterLease"
            },
            "type": {
              "type": "string",
              "const": "release_writer_lease"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/SubmitComposerText"
            },
            "type": {
              "type": "string",
              "const": "submit_composer_text"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/RawTerminalInput"
            },
            "type": {
              "type": "string",
              "const": "raw_terminal_input"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/InterruptTerminal"
            },
            "type": {
              "type": "string",
              "const": "interrupt_terminal"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/TerminalResize"
            },
            "type": {
              "type": "string",
              "const": "terminal_resize"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/TerminalKeyInput"
            },
            "type": {
              "type": "string",
              "const": "terminal_key"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/CreateSession"
            },
            "type": {
              "type": "string",
              "const": "create_session"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/ResumeSession"
            },
            "type": {
              "type": "string",
              "const": "resume_session"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/QuickInsertPreviewRequest"
            },
            "type": {
              "type": "string",
              "const": "quick_insert_preview"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/QuickInsertSubmit"
            },
            "type": {
              "type": "string",
              "const": "quick_insert_submit"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/UploadBegin"
            },
            "type": {
              "type": "string",
              "const": "upload_begin"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/UploadCommit"
            },
            "type": {
              "type": "string",
              "const": "upload_commit"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/UploadCancel"
            },
            "type": {
              "type": "string",
              "const": "upload_cancel"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "disconnect"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ConnectionPath": {
      "type": "string",
      "enum": [
        "tailnet_direct",
        "tailnet_relay",
        "loopback_development",
        "unknown"
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "connected",
        "reconnecting",
        "mac_offline",
        "tailscale_needed",
        "authorization_revoked",
        "version_incompatible"
      ]
    },
    "CreateSession": {
      "type": "object",
      "properties": {
        "app_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "cwd": {
          "type": "string"
        },
        "initial_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/SessionKind"
        },
        "project_id": {
          "type": "string"
        },
        "workspace_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "app_instance_id",
        "workspace_revision",
        "project_id",
        "kind",
        "cwd"
      ]
    },
    "DevicePlatform": {
      "type": "string",
      "enum": [
        "ios",
        "ipados",
        "macos",
        "android",
        "other"
      ]
    },
    "DeviceSummary": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "connected": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "last_seen_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "name": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/DevicePlatform"
        }
      },
      "required": [
        "id",
        "name",
        "platform",
        "capabilities",
        "connected"
      ]
    },
    "HostSnapshot": {
      "type": "object",
      "properties": {
        "app_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "connection_path": {
          "$ref": "#/$defs/ConnectionPath"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "app_instance_id",
        "name",
        "connection_path",
        "capabilities"
      ]
    },
    "InterruptTerminal": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "workspace_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "workspace_revision"
      ]
    },
    "PairingClaimReceipt": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "format": "uuid"
        },
        "claim_secret": {
          "type": "string"
        },
        "device_name": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "public_key_fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_secret",
        "device_name",
        "public_key_fingerprint",
        "expires_at"
      ]
    },
    "PairingClaimRequest": {
      "type": "object",
      "properties": {
        "device_name": {
          "type": "string"
        },
        "invitation_id": {
          "type": "string",
          "format": "uuid"
        },
        "platform": {
          "$ref": "#/$defs/DevicePlatform"
        },
        "public_key_p256_raw": {
          "description": "Base64-encoded 65-byte uncompressed SEC1 point for an ECDSA P-256 public key.",
          "type": "string"
        },
        "secret": {
          "type": "string"
        }
      },
      "required": [
        "invitation_id",
        "secret",
        "device_name",
        "platform",
        "public_key_p256_raw"
      ]
    },
    "PairingInvitation": {
      "type": "object",
      "properties": {
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "pairing_url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "pairing_url",
        "expires_at"
      ]
    },
    "PairingStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "pending"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "capabilities": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Capability"
                  }
                },
                "device_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "device_id",
                "capabilities"
              ]
            },
            "status": {
              "type": "string",
              "const": "approved"
            }
          },
          "required": [
            "status",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "rejected"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "expired"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "PairingStatusRequest": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "format": "uuid"
        },
        "claim_secret": {
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_secret"
      ]
    },
    "PaneKind": {
      "type": "string",
      "enum": [
        "terminal",
        "claude_code",
        "codex",
        "notebook",
        "other"
      ]
    },
    "PaneSnapshot": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "agent_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentState"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalDimensions"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PaneKind"
        },
        "quick_inserts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuickInsertDescriptor"
          }
        },
        "title": {
          "type": "string"
        },
        "writer_lease": {
          "anyOf": [
            {
              "$ref": "#/$defs/WriterLeaseSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "active",
        "quick_inserts"
      ]
    },
    "ProjectActivity": {
      "type": "string",
      "enum": [
        "working",
        "done",
        "needs_attention",
        "idle",
        "running_command"
      ]
    },
    "ProjectSnapshot": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "activity": {
          "$ref": "#/$defs/ProjectActivity"
        },
        "id": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TabSnapshot"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "order",
        "active",
        "activity",
        "tabs"
      ]
    },
    "ProtocolError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProtocolErrorCode"
        },
        "current_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ProtocolErrorCode": {
      "type": "string",
      "enum": [
        "unauthorized",
        "capability_denied",
        "invalid_request",
        "unsupported_version",
        "target_gone",
        "revision_conflict",
        "writer_lease_held",
        "stale_quick_insert",
        "upload_rejected",
        "rate_limited",
        "resync_required",
        "internal"
      ]
    },
    "QuickInsertDescriptor": {
      "type": "object",
      "properties": {
        "configuration_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/QuickInsertKind"
        },
        "label": {
          "type": "string"
        },
        "submits_immediately": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "configuration_revision",
        "label",
        "kind",
        "submits_immediately"
      ]
    },
    "QuickInsertKind": {
      "type": "string",
      "enum": [
        "built_in",
        "custom"
      ]
    },
    "QuickInsertPreview": {
      "type": "object",
      "properties": {
        "configuration_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "item_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "configuration_revision",
        "text"
      ]
    },
    "QuickInsertPreviewRequest": {
      "type": "object",
      "properties": {
        "configuration_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "item_id": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "workspace_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "workspace_revision",
        "item_id",
        "configuration_revision"
      ]
    },
    "QuickInsertSubmit": {
      "type": "object",
      "properties": {
        "configuration_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "item_id": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "workspace_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "workspace_revision",
        "item_id",
        "configuration_revision"
      ]
    },
    "RawTerminalInput": {
      "type": "object",
      "properties": {
        "data_base64": {
          "description": "Base64-encoded PTY bytes for an interactive terminal/TUI.",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "workspace_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "target",
        "workspace_revision",
        "data_base64"
      ]
    },
    "RecentAgentSessionSnapshot": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "durable_session_id": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/AgentProvider"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
