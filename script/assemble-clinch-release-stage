#!/usr/bin/env bash
# Assembles, signs, and verifies the exact draft-release asset set locally.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

VERSION="${1:?usage: assemble-clinch-release-stage <version> <commit> <sequence>}"
COMMIT="${2:?missing commit}"
UPDATE_SEQUENCE="${3:?missing sequence}"

RELEASE_DIR="target/release-lto/bundle/osx"
case "${UNIVERSAL:-0}" in
  1|true|yes)
    RELEASE_LAYOUT=universal
    STABLE_APP="$RELEASE_DIR/Clinch.app"
    ;;
  0|false|no)
    RELEASE_LAYOUT=native
    STABLE_APP="target/aarch64-apple-darwin/release-lto/bundle/osx/Clinch.app"
    ;;
  *) echo "release staging failed: UNIVERSAL must be 0 or 1" >&2; exit 1 ;;
esac
STAGE="target/release-stage/$VERSION"
DIST="$STAGE/dist"
ALLOWED_SIGNERS="resources/release/clinch-release-allowed-signers"
RELEASE_KEY="${CLINCH_RELEASE_SIGNING_KEY:-$HOME/.config/clinch/release-signing-key}"

fail() {
  echo "release staging failed: $*" >&2
  exit 1
}

[[ "$VERSION" =~ ^v[0-9]+(\.[0-9]+)+$ ]] || fail "invalid version $VERSION"
[[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || fail "invalid commit"
[[ "$UPDATE_SEQUENCE" =~ ^[0-9]+$ && "$UPDATE_SEQUENCE" -gt 0 ]] \
  || fail "invalid update sequence"
[[ "$(git rev-parse HEAD)" == "$COMMIT" ]] || fail "source commit changed before staging"
[[ -d "$STABLE_APP" ]] || fail "missing verified app bundle $STABLE_APP"
release_artifacts=(
  Clinch.dmg
  Clinch.dmg.sha256
  Clinch.app.zip
  Clinch.app.zip.sha256
  Clinch.update.json
  Clinch.update.sig
  Clinch.update.sshsig
)
if [[ "$RELEASE_LAYOUT" == native ]]; then
  [[ -d target/x86_64-apple-darwin/release-lto/bundle/osx/Clinch.app ]] \
    || fail "missing verified Intel app bundle"
  release_artifacts+=(
    Clinch-x86_64.dmg
    Clinch-x86_64.dmg.sha256
    Clinch-x86_64.app.zip
    Clinch-x86_64.app.zip.sha256
  )
fi
for item in \
  "${release_artifacts[@]/#/$RELEASE_DIR/}" \
  install.sh uninstall.sh "$ALLOWED_SIGNERS" "$RELEASE_KEY" Cargo.lock; do
  [[ -f "$item" ]] || fail "missing $item"
done
command -v syft >/dev/null 2>&1 || fail "syft is required (brew install syft)"

actual_release_key="$(ssh-keygen -y -f "$RELEASE_KEY" | awk '{print $1, $2}')"
expected_release_key="$(awk 'NF {print $2, $3; exit}' "$ALLOWED_SIGNERS")"
[[ "$actual_release_key" == "$expected_release_key" ]] \
  || fail "release signing key does not match the committed trust root"

rm -rf "$STAGE"
mkdir -p "$DIST"
for artifact in "${release_artifacts[@]}"; do
  cp "$RELEASE_DIR/$artifact" "$DIST/"
done
cp install.sh uninstall.sh "$ALLOWED_SIGNERS" "$DIST/"

echo "==> Assembling version-matched complete Corresponding Source"
./script/assemble-clinch-corresponding-source \
  "$VERSION" "$COMMIT" "$DIST/Clinch.source.tar.gz"

echo "==> Generating CycloneDX SBOM"
syft "$STABLE_APP" -o "cyclonedx-json=$DIST/Clinch.sbom.cdx.json"
if [[ "$RELEASE_LAYOUT" == native ]]; then
  syft target/x86_64-apple-darwin/release-lto/bundle/osx/Clinch.app \
    -o "cyclonedx-json=$DIST/Clinch-x86_64.sbom.cdx.json"
fi

builder_os_version="$(sw_vers -productVersion)"
builder_architecture="$(uname -m)"
created_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
started_at="${CLINCH_RELEASE_STARTED_AT:-$created_at}"
[[ "$started_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] \
  || fail "invalid local release start timestamp"

/usr/bin/python3 - \
  "$DIST/Clinch.release-validation.json" \
  "$VERSION" "$COMMIT" "$UPDATE_SEQUENCE" \
  "$builder_os_version" "$builder_architecture" "$RELEASE_LAYOUT" <<'PY'
import json
import pathlib
import sys

output = pathlib.Path(sys.argv[1])
value = {
    "artifact_checks": [
        (
            "universal x86_64+arm64"
            if sys.argv[7] == "universal"
            else "separate native arm64 and x86_64 bundles"
        ),
        "ad-hoc hardened-runtime signature",
        "no Apple Events entitlement or usage description",
        "no bundled iMessage helper",
        (
            "ZIP/DMG app equality"
            if sys.argv[7] == "universal"
            else "architecture-specific ZIP/DMG app equality"
        ),
        "exact licenses, modification notice, and third-party notices",
        "versioned complete corresponding source archive",
        "default-on integration, opt-out, and removal",
        "signed exact-tag manifest",
    ],
    "builder": {
        "architecture": sys.argv[6],
        "kind": "local-release-workstation",
        "os": "macOS",
        "os_version": sys.argv[5],
    },
    "commit": sys.argv[3],
    "gates": ["Local full release gate"],
    "notarized": False,
    "publication": {
        "command": "make release",
        "kind": "local-release-command",
    },
    "release_layout": sys.argv[7],
    "schema_version": 5,
    "update_sequence": int(sys.argv[4]),
    "version": sys.argv[2],
}
output.write_text(
    json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n",
    encoding="utf-8",
)
PY

primary_assets=(
  Clinch.dmg
  Clinch.dmg.sha256
  Clinch.app.zip
  Clinch.app.zip.sha256
  Clinch.source.tar.gz
  Clinch.source.tar.gz.sha256
  Clinch.update.json
  Clinch.update.sig
  Clinch.update.sshsig
  install.sh
  uninstall.sh
  clinch-release-allowed-signers
  Clinch.sbom.cdx.json
  Clinch.release-validation.json
)
if [[ "$RELEASE_LAYOUT" == native ]]; then
  primary_assets+=(
    Clinch-x86_64.dmg
    Clinch-x86_64.dmg.sha256
    Clinch-x86_64.app.zip
    Clinch-x86_64.app.zip.sha256
    Clinch-x86_64.sbom.cdx.json
  )
fi

CLINCH_RELEASE_LAYOUT="$RELEASE_LAYOUT" /usr/bin/python3 - \
  "$DIST/Clinch.build-provenance.json" "$DIST" "$VERSION" "$COMMIT" \
  "$UPDATE_SEQUENCE" "$started_at" "$created_at" "$ROOT/Cargo.lock" \
  "$ROOT/web/remote-control/yarn.lock" \
  "${primary_assets[@]}" <<'PY'
import hashlib
import json
import os
import pathlib
import sys

output = pathlib.Path(sys.argv[1])
dist = pathlib.Path(sys.argv[2])
version = sys.argv[3]
commit = sys.argv[4]
sequence = int(sys.argv[5])
started_at = sys.argv[6]
finished_at = sys.argv[7]
lockfile = pathlib.Path(sys.argv[8])
yarn_lockfile = pathlib.Path(sys.argv[9])
asset_names = sys.argv[10:]


def digest(path):
    value = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            value.update(chunk)
    return value.hexdigest()


value = {
    "_type": "https://in-toto.io/Statement/v1",
    "predicateType": "https://slsa.dev/provenance/v1",
    "predicate": {
        "buildDefinition": {
            "buildType": (
                "https://github.com/elliot-ylambda/clinch-terminal/local-release/v1"
            ),
            "externalParameters": {
                "release_layout": os.environ["CLINCH_RELEASE_LAYOUT"],
                "update_sequence": sequence,
                "version": version,
            },
            "internalParameters": {},
            "resolvedDependencies": [
                {
                    "digest": {"sha1": commit},
                    "uri": (
                        "git+https://github.com/elliot-ylambda/"
                        f"clinch-terminal@{commit}"
                    ),
                },
                {
                    "digest": {"sha256": digest(lockfile)},
                    "uri": "file:Cargo.lock",
                },
                {
                    "digest": {"sha256": digest(yarn_lockfile)},
                    "uri": "file:web/remote-control/yarn.lock",
                },
            ],
        },
        "runDetails": {
            "builder": {
                "id": (
                    "https://github.com/elliot-ylambda/clinch-terminal/blob/"
                    f"{commit}/script/assemble-clinch-release-stage"
                )
            },
            "metadata": {
                "finishedOn": finished_at,
                "invocationId": f"{version}-{commit}",
                "startedOn": started_at,
            },
        },
    },
    "subject": [
        {"digest": {"sha256": digest(dist / name)}, "name": name}
        for name in asset_names
    ],
}
output.write_text(
    json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n",
    encoding="utf-8",
)
PY

ssh-keygen -Y sign -f "$RELEASE_KEY" -n clinch-provenance - \
  < "$DIST/Clinch.build-provenance.json" \
  > "$DIST/Clinch.build-provenance.sshsig"

checksummed_assets=(
  "${primary_assets[@]}"
  Clinch.build-provenance.json
  Clinch.build-provenance.sshsig
)
: > "$DIST/Clinch.checksums.txt"
for asset in "${checksummed_assets[@]}"; do
  (cd "$DIST" && shasum -a 256 "$asset") >> "$DIST/Clinch.checksums.txt"
done
ssh-keygen -Y sign -f "$RELEASE_KEY" -n clinch-checksums - \
  < "$DIST/Clinch.checksums.txt" > "$DIST/Clinch.checksums.sshsig"

if [[ "$RELEASE_LAYOUT" == native ]]; then
  download_note='Download **Clinch.dmg** on Apple Silicon or **Clinch-x86_64.dmg** on Intel'
  transition_note='Intel installations that predate native-archive selection need one authenticated manual install for this transition.'
else
  download_note='Download the universal **Clinch.dmg**'
  transition_note=
fi
cat > "$STAGE/release-notes.md" <<EOF
Clinch $VERSION is an unnotarized public preview for macOS 14 or later on Intel and Apple Silicon.

$download_note, authenticate
**Clinch.checksums.txt** with **Clinch.checksums.sshsig**, compare the DMG digest, and drag Clinch to Applications.
Use **System Settings → Privacy & Security → Open Anyway** if macOS blocks the first launch.
The authenticated **install.sh** asset is a secondary convenience.

Session restore is enabled by default and can be turned off or back on in Clinch Settings.
This release checks signed update metadata at most daily and shows **Update Clinch** in the
header; installation requires explicit consent. Builds older than the updater bridge need one
final authenticated manual install. The bridge is **v0.2026.07.20.1643**; non-writable app
installations continue to use the manual installer. See **Clinch.release-validation.json** and
**Clinch.build-provenance.json** for the automated validation and local-builder records
authenticated by the Clinch release key. No manual QA attestation is required or recorded by the
release command.
$transition_note

Complete Corresponding Source for this exact binary release, including vendored Cargo dependency
sources, is provided as **Clinch.source.tar.gz** with its digest in
**Clinch.source.tar.gz.sha256**:
https://github.com/elliot-ylambda/clinch-terminal/releases/download/$VERSION/Clinch.source.tar.gz
EOF

./script/verify-clinch-release-stage "$DIST" "$VERSION" "$COMMIT" "$UPDATE_SEQUENCE"
echo "$STAGE"
