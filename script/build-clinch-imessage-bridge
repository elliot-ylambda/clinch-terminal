#!/usr/bin/env bash
# Builds the pinned Swift Messages bridge and copies its executable and
# SwiftPM resource bundles into Clinch.app/Contents/Helpers.
set -euo pipefail

DESTINATION="${1:?usage: build-clinch-imessage-bridge <helpers-dir> [--universal]}"
MODE="${2:-}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PACKAGE_DIR="$REPO_ROOT/tools/imessage-bridge"
PRODUCT="clinch-imessage-bridge"

if [[ "$MODE" == "--universal" ]]; then
  swift build \
    --package-path "$PACKAGE_DIR" \
    --configuration release \
    --product "$PRODUCT" \
    --arch arm64 \
    --arch x86_64
  BIN_DIR="$(swift build \
    --package-path "$PACKAGE_DIR" \
    --configuration release \
    --show-bin-path \
    --arch arm64 \
    --arch x86_64)"
elif [[ -n "$MODE" ]]; then
  echo "unknown option: $MODE" >&2
  exit 2
else
  swift build \
    --package-path "$PACKAGE_DIR" \
    --configuration release \
    --product "$PRODUCT"
  BIN_DIR="$(swift build \
    --package-path "$PACKAGE_DIR" \
    --configuration release \
    --show-bin-path)"
fi

# Run the product while it is still in SwiftPM's build directory, where its
# generated resource-bundle lookup is valid. macOS intentionally refuses to
# launch an unsigned executable after it has been placed inside an app bundle;
# the release verifier runs this self-test again after the app is signed.
"$BIN_DIR/$PRODUCT" --self-test >/dev/null

mkdir -p "$DESTINATION"
install -m 0755 "$BIN_DIR/$PRODUCT" "$DESTINATION/$PRODUCT"
for bundle in \
  PhoneNumberKit_PhoneNumberKit.bundle \
  SQLite.swift_SQLite.bundle; do
  [[ -d "$BIN_DIR/$bundle" ]] || {
    echo "missing Swift resource bundle: $BIN_DIR/$bundle" >&2
    exit 1
  }
  rm -rf "$DESTINATION/$bundle"
  cp -R "$BIN_DIR/$bundle" "$DESTINATION/$bundle"

  # Command-line SwiftPM builds emit flat resource directories without bundle
  # metadata. That works for Bundle.module, but codesign --deep treats their
  # .bundle suffix as nested code and rejects the entire app unless each one is
  # a structurally valid resource bundle.
  case "$bundle" in
    PhoneNumberKit_PhoneNumberKit.bundle)
      bundle_identifier="sh.clinch.ClinchIMessageBridge.PhoneNumberKit"
      ;;
    SQLite.swift_SQLite.bundle)
      bundle_identifier="sh.clinch.ClinchIMessageBridge.SQLiteSwift"
      ;;
  esac
  bundle_plist="$DESTINATION/$bundle/Info.plist"
  /usr/bin/plutil -create xml1 "$bundle_plist"
  /usr/bin/plutil -insert CFBundleDevelopmentRegion -string en "$bundle_plist"
  /usr/bin/plutil -insert CFBundleIdentifier -string "$bundle_identifier" "$bundle_plist"
  /usr/bin/plutil -insert CFBundleInfoDictionaryVersion -string 6.0 "$bundle_plist"
  /usr/bin/plutil -insert CFBundleName -string "${bundle%.bundle}" "$bundle_plist"
  /usr/bin/plutil -insert CFBundlePackageType -string BNDL "$bundle_plist"
  /usr/bin/plutil -insert CFBundleShortVersionString -string 1.0 "$bundle_plist"
  /usr/bin/plutil -insert CFBundleVersion -string 1 "$bundle_plist"
  chmod 0644 "$bundle_plist"
  /usr/bin/plutil -lint "$bundle_plist" >/dev/null
done

if [[ "$MODE" == "--universal" ]]; then
  lipo "$DESTINATION/$PRODUCT" -verify_arch arm64 x86_64
fi
