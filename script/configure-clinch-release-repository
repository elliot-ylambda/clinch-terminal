#!/usr/bin/env bash
# Applies repository controls for direct, workstation-published releases.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

REPO="${CLINCH_REPO:-elliot-ylambda/clinch-terminal}"
BRANCH="${CLINCH_RELEASE_BRANCH:-main}"
RELEASE_ENVIRONMENT="${CLINCH_RELEASE_ENVIRONMENT:-public-release}"
UPDATE_KEY="${CLINCH_UPDATE_SIGNING_KEY:-$HOME/.config/clinch/update-signing-key.pem}"
RELEASE_KEY="${CLINCH_RELEASE_SIGNING_KEY:-$HOME/.config/clinch/release-signing-key}"
ALLOWED_SIGNERS="$ROOT/resources/release/clinch-release-allowed-signers"

for command in gh jq ssh-keygen; do
  command -v "$command" >/dev/null || { echo "$command is required" >&2; exit 1; }
done
gh auth status >/dev/null

tmp="$(mktemp -d -t clinch-repository-policy)"
trap 'rm -rf "$tmp"' EXIT
jq -n '{
  required_status_checks: null,
  enforce_admins: true,
  required_pull_request_reviews: null,
  restrictions: null,
  required_linear_history: true,
  allow_force_pushes: false,
  allow_deletions: false,
  block_creations: false,
  required_conversation_resolution: true,
  lock_branch: false,
  allow_fork_syncing: true
}' > "$tmp/protection.json"

echo "Applying protected-main policy to $REPO..."
gh api --method PUT "repos/$REPO/branches/$BRANCH/protection" \
  --input "$tmp/protection.json" >/dev/null

echo "Restricting default GitHub Actions token permissions..."
gh api --method PUT "repos/$REPO/actions/permissions/workflow" \
  -f default_workflow_permissions=read -F can_approve_pull_request_reviews=false >/dev/null

if gh api "repos/$REPO/environments/$RELEASE_ENVIRONMENT" >/dev/null 2>&1; then
  echo "Removing the obsolete $RELEASE_ENVIRONMENT environment..."
  [[ -f "$UPDATE_KEY" ]] || {
    echo "refusing to remove the environment: local update key is missing at $UPDATE_KEY" >&2
    exit 1
  }
  [[ -f "$RELEASE_KEY" ]] || {
    echo "refusing to remove the environment: local release key is missing at $RELEASE_KEY" >&2
    exit 1
  }
  ./script/clinch-update-manifest verify-key \
    "$UPDATE_KEY" resources/update/clinch-update-public-key.json >/dev/null
  actual_release_key="$(ssh-keygen -y -f "$RELEASE_KEY" | awk '{print $1, $2}')"
  expected_release_key="$(awk 'NF {print $2, $3; exit}' "$ALLOWED_SIGNERS")"
  [[ "$actual_release_key" == "$expected_release_key" ]] || {
    echo "refusing to remove the environment: local release key does not match" >&2
    exit 1
  }
  environment_secrets="$(gh secret list --repo "$REPO" --env "$RELEASE_ENVIRONMENT" \
    --json name --jq '.[].name')"
  for secret in CLINCH_RELEASE_SIGNING_KEY CLINCH_UPDATE_SIGNING_KEY; do
    if grep -Fxq "$secret" <<< "$environment_secrets"; then
      gh secret delete "$secret" --repo "$REPO" --env "$RELEASE_ENVIRONMENT"
    fi
  done
  gh api --method DELETE "repos/$REPO/environments/$RELEASE_ENVIRONMENT" >/dev/null
fi

echo "Enabling immutable releases and security reporting..."
gh api --method PUT "repos/$REPO/immutable-releases" >/dev/null
gh api --method PUT "repos/$REPO/private-vulnerability-reporting" >/dev/null || true
gh api --method PUT "repos/$REPO/vulnerability-alerts" >/dev/null
gh api --method PUT "repos/$REPO/automated-security-fixes" >/dev/null || true

jq -n '{
  security_and_analysis: {
    secret_scanning: {status: "enabled"},
    secret_scanning_push_protection: {status: "enabled"}
  },
  delete_branch_on_merge: true,
  allow_update_branch: true
}' > "$tmp/repository.json"
gh api --method PATCH "repos/$REPO" --input "$tmp/repository.json" >/dev/null

echo "Repository release policy is configured for $REPO/$BRANCH."
echo "Release build, signing, remote-draft verification, and publication: local workstation only"
echo "GitHub Actions release workflow: none"
