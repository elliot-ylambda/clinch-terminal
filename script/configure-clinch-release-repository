#!/usr/bin/env bash
# Applies the repository controls assumed by the public release workflow.
# Run only after .github/workflows/{ci,release}.yml has landed on main.
set -euo pipefail

REPO="${CLINCH_REPO:-elliot-ylambda/clinch-terminal}"
BRANCH="${CLINCH_RELEASE_BRANCH:-main}"
APPROVALS="${CLINCH_REQUIRED_APPROVALS:-0}"
RELEASE_ENVIRONMENT="${CLINCH_RELEASE_ENVIRONMENT:-public-release}"
RELEASE_REVIEWER="${CLINCH_RELEASE_REVIEWER:-}"

[[ "$APPROVALS" =~ ^[0-6]$ ]] || {
  echo "CLINCH_REQUIRED_APPROVALS must be between 0 and 6" >&2
  exit 2
}
command -v gh >/dev/null || { echo "gh is required" >&2; exit 1; }
gh auth status >/dev/null
if [[ -z "$RELEASE_REVIEWER" ]]; then
  RELEASE_REVIEWER="$(gh api user --jq .login)"
fi
RELEASE_REVIEWER_ID="$(gh api "users/$RELEASE_REVIEWER" --jq .id)"
[[ "$RELEASE_REVIEWER_ID" =~ ^[0-9]+$ ]] \
  || { echo "could not resolve release reviewer $RELEASE_REVIEWER" >&2; exit 1; }

for workflow in ci.yml release.yml; do
  gh api "repos/$REPO/contents/.github/workflows/$workflow?ref=$BRANCH" >/dev/null \
    || {
      echo "$workflow is not present on $BRANCH; land the workflows before applying policy" >&2
      exit 1
    }
done

tmp="$(mktemp -d -t clinch-repository-policy)"
trap 'rm -rf "$tmp"' EXIT
jq -n --argjson approvals "$APPROVALS" '{
  required_status_checks: {
    strict: true,
    contexts: ["Clinch PR checks"]
  },
  enforce_admins: true,
  required_pull_request_reviews: {
    dismiss_stale_reviews: true,
    require_code_owner_reviews: false,
    require_last_push_approval: ($approvals > 0),
    required_approving_review_count: $approvals
  },
  restrictions: null,
  required_linear_history: true,
  allow_force_pushes: false,
  allow_deletions: false,
  block_creations: false,
  required_conversation_resolution: true,
  lock_branch: false,
  allow_fork_syncing: true
}' > "$tmp/protection.json"

echo "Applying protected-main policy to $REPO..."
gh api --method PUT "repos/$REPO/branches/$BRANCH/protection" \
  --input "$tmp/protection.json" >/dev/null

echo "Restricting default GitHub Actions token permissions..."
gh api --method PUT "repos/$REPO/actions/permissions/workflow" \
  -f default_workflow_permissions=read -F can_approve_pull_request_reviews=false >/dev/null

echo "Protecting the $RELEASE_ENVIRONMENT release environment..."
jq -n --argjson reviewer_id "$RELEASE_REVIEWER_ID" '{
  wait_timer: 0,
  prevent_self_review: false,
  can_admins_bypass: false,
  reviewers: [{type: "User", id: $reviewer_id}],
  deployment_branch_policy: {
    protected_branches: true,
    custom_branch_policies: false
  }
}' > "$tmp/environment.json"
gh api --method PUT "repos/$REPO/environments/$RELEASE_ENVIRONMENT" \
  --input "$tmp/environment.json" >/dev/null

environment_secrets="$(gh secret list --repo "$REPO" --env "$RELEASE_ENVIRONMENT" \
  --json name --jq 'map(.name) | sort | join(" ")')"
[[ "$environment_secrets" == *CLINCH_RELEASE_SIGNING_KEY* \
  && "$environment_secrets" == *CLINCH_UPDATE_SIGNING_KEY* ]] || {
  echo "set both signing keys as $RELEASE_ENVIRONMENT environment secrets before release" >&2
  exit 1
}

echo "Enabling immutable releases and security reporting..."
gh api --method PUT "repos/$REPO/immutable-releases" >/dev/null
gh api --method PUT "repos/$REPO/private-vulnerability-reporting" >/dev/null || true
gh api --method PUT "repos/$REPO/vulnerability-alerts" >/dev/null
gh api --method PUT "repos/$REPO/automated-security-fixes" >/dev/null || true

jq -n '{
  security_and_analysis: {
    secret_scanning: {status: "enabled"},
    secret_scanning_push_protection: {status: "enabled"}
  },
  delete_branch_on_merge: true,
  allow_update_branch: true
}' > "$tmp/repository.json"
gh api --method PATCH "repos/$REPO" --input "$tmp/repository.json" >/dev/null

echo "Repository release policy is configured for $REPO/$BRANCH."
echo "Required approvals: $APPROVALS"
echo "Release environment reviewer: $RELEASE_REVIEWER"
