#!/usr/bin/env python3
"""Watch local macOS Clinch CPU and memory, separating the app from its children."""

import argparse
import csv
import ctypes
from datetime import datetime, timezone
import os
import subprocess
import sys
import time


class RusageInfo(ctypes.Structure):
    # Darwin sys/resource.h: rusage_info_v0, supported since macOS 10.9.
    _fields_ = [("uuid", ctypes.c_uint8 * 16)] + [
        (name, ctypes.c_uint64) for name in (
            "user_time", "system_time", "pkg_idle_wkups", "interrupt_wkups",
            "pageins", "wired_size", "resident_size", "phys_footprint",
            "proc_start_abstime", "proc_exit_abstime",
        )
    ]


def read_usage(libproc, pid):
    info = RusageInfo()
    if libproc.proc_pid_rusage(pid, 0, ctypes.byref(info)) != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    return info


def descendants(root, parents):
    children = {}
    for pid, parent in parents.items():
        children.setdefault(parent, []).append(pid)
    found = set()
    pending = list(children.get(root, []))
    while pending:
        pid = pending.pop()
        if pid == root or pid in found:
            continue
        found.add(pid)
        pending.extend(children.get(pid, []))
    return found


def child_pids(root):
    output = subprocess.run(
        ["ps", "-axo", "pid=,ppid="], check=True, capture_output=True, text=True, timeout=10
    ).stdout
    return descendants(root, {int(pid): int(parent) for pid, parent in (line.split() for line in output.splitlines())})


class MachTimebase(ctypes.Structure):
    _fields_ = [("numer", ctypes.c_uint32), ("denom", ctypes.c_uint32)]


def nanoseconds_per_tick():
    libsystem = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
    libsystem.mach_timebase_info.argtypes = [ctypes.POINTER(MachTimebase)]
    libsystem.mach_timebase_info.restype = ctypes.c_int
    timebase = MachTimebase()
    if libsystem.mach_timebase_info(ctypes.byref(timebase)) != 0 or not timebase.denom or not timebase.numer:
        raise RuntimeError("Cannot read the macOS CPU clock timebase")
    return timebase.numer / timebase.denom


def cpu_percent(current, previous, elapsed, ns_per_tick):
    if previous is None or current.proc_start_abstime != previous.proc_start_abstime:
        return None
    # rusage CPU counters use Mach ticks; Apple Silicon ticks are NOT nanoseconds.
    # See apple-oss-distributions/xnu doc/observability/recount.md.
    # Convert using the host timebase. 100% is one CPU core.
    delta = current.user_time + current.system_time - previous.user_time - previous.system_time
    return max(0, delta) * ns_per_tick / (elapsed * 1_000_000_000) * 100


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pid", type=int, default=os.environ.get("CLINCH_CONTROL_PID"), help="default: this terminal's CLINCH_CONTROL_PID")
    parser.add_argument("--interval", type=float, default=5, help="seconds between samples, minimum 1 (default: 5)")
    parser.add_argument("--samples", type=int, default=0, help="stop after N rows; 0 watches until Ctrl-C")
    parser.add_argument("--csv", help="write samples to a new CSV file; '-' writes CSV to stdout")
    args = parser.parse_args()
    if sys.platform != "darwin":
        parser.error("this watcher uses macOS process accounting")
    if not args.pid or args.pid < 1:
        parser.error("pass --pid for the Clinch process, or run from a bound Clinch terminal")
    if not 1 <= args.interval <= 3600 or args.samples < 0:
        parser.error("--interval must be between 1 and 3600 seconds; --samples cannot be negative")
    libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
    libproc.proc_pid_rusage.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.POINTER(RusageInfo)]
    libproc.proc_pid_rusage.restype = ctypes.c_int
    ns_per_tick = nanoseconds_per_tick()
    initial = read_usage(libproc, args.pid)
    start_id = initial.proc_start_abstime
    columns = [
        "timestamp", "pid", "app_cpu_pct", "app_footprint_mib", "app_rss_mib",
        "descendant_count", "descendants_cpu_pct", "descendants_footprint_mib", "unreadable_descendants",
    ]
    csv_file = None
    writer = None
    if args.csv:
        csv_file = sys.stdout if args.csv == "-" else open(args.csv, "x", newline="", encoding="utf-8")
        writer = csv.DictWriter(csv_file, fieldnames=columns)
        writer.writeheader()
    human = args.csv != "-"
    if human:
        print("App footprint includes compressed memory. Child totals are separate and may include shared memory.")
        print("CPU: 100% = one core; child CPU covers processes present in consecutive samples. Ctrl-C stops.")
        print("TIME       APP CPU   FOOTPRINT    RSS MiB   CHILDREN   CHILD CPU   CHILD MiB   UNREADABLE")
    previous = {}
    previous_time = None
    count = 0
    try:
        while True:
            started = time.monotonic()
            current = read_usage(libproc, args.pid)
            if current.proc_start_abstime != start_id:
                raise RuntimeError("Clinch exited and its PID was reused; stopping")
            child_ids = child_pids(args.pid)
            usages = {args.pid: current}
            for pid in child_ids:
                try:
                    usages[pid] = read_usage(libproc, pid)
                except OSError:
                    pass  # It exited between discovery and sampling, or access was denied.
            elapsed = started - previous_time if previous_time is not None else 1
            app_cpu = cpu_percent(current, previous.get(args.pid), elapsed, ns_per_tick)
            child_cpu = sum(cpu_percent(info, previous.get(pid), elapsed, ns_per_tick) or 0 for pid, info in usages.items() if pid != args.pid)
            mib = 1024 * 1024
            row = dict(zip(columns, [
                datetime.now(timezone.utc).isoformat(timespec="seconds"), args.pid,
                "" if app_cpu is None else round(app_cpu, 2),
                round(current.phys_footprint / mib, 2), round(current.resident_size / mib, 2),
                len(child_ids), "" if previous_time is None else round(child_cpu, 2),
                round(sum(info.phys_footprint for pid, info in usages.items() if pid != args.pid) / mib, 2),
                len(child_ids) - len(usages) + 1,
            ]))
            if writer:
                writer.writerow(row)
                csv_file.flush()
            if human:
                cpu_label = "—" if app_cpu is None else f"{app_cpu:.1f}%"
                child_label = "—" if previous_time is None else f"{child_cpu:.1f}%"
                print(f"{datetime.now():%H:%M:%S} {cpu_label:>9} {row['app_footprint_mib']:>11.1f} {row['app_rss_mib']:>10.1f}"
                      f" {len(child_ids):>10} {child_label:>11} {row['descendants_footprint_mib']:>11.1f}"
                      f" {row['unreadable_descendants']:>12}", flush=True)
            previous, previous_time = usages, started
            count += 1
            if args.samples and count >= args.samples:
                break
            time.sleep(max(0, args.interval - (time.monotonic() - started)))
    finally:
        if csv_file and csv_file is not sys.stdout:
            csv_file.close()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"watch-clinch-resources: {error}", file=sys.stderr)
        sys.exit(1)
