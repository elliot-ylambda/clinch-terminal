#!/usr/bin/env bash
# Verifies the exact app/zip/DMG that the Makefile is about to publish.
set -euo pipefail

APP="${1:?usage: verify-clinch-release <app> <zip> <sha256> <dmg> <version> <manifest> <signature> <sequence>}"
ZIP="${2:?missing zip}"
SHA_FILE="${3:?missing checksum sidecar}"
DMG="${4:?missing dmg}"
VERSION="${5:?missing version}"
MANIFEST="${6:?missing update manifest}"
SIGNATURE="${7:?missing update signature}"
UPDATE_SEQUENCE="${8:?missing update sequence}"

fail() { echo "release verification failed: $*" >&2; exit 1; }
for path in "$APP" "$ZIP" "$SHA_FILE" "$DMG" "$MANIFEST" "$SIGNATURE"; do
  [[ -e "$path" ]] || fail "missing $path"
done

PLIST="$APP/Contents/Info.plist"
[[ "$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$PLIST")" == "sh.clinch.Clinch" ]] \
  || fail "bundle identifier is not sh.clinch.Clinch"
[[ "$(/usr/libexec/PlistBuddy -c 'Print CFBundleName' "$PLIST")" == "Clinch" ]] \
  || fail "bundle name is not Clinch"
[[ "$(/usr/libexec/PlistBuddy -c 'Print WarpVersion' "$PLIST")" == "$VERSION" ]] \
  || fail "bundle version does not match $VERSION"
[[ "$(/usr/libexec/PlistBuddy -c 'Print ClinchUpdateSequence' "$PLIST")" == "$UPDATE_SEQUENCE" ]] \
  || fail "bundle update sequence does not match $UPDATE_SEQUENCE"

codesign --verify --deep --strict "$APP" || fail "app code signature is invalid"
entitlements="$(codesign -d --entitlements :- "$APP" 2>/dev/null || true)"
[[ "$entitlements" != *"get-task-allow"* ]] \
  || fail "release carries the development-only get-task-allow entitlement"

MAIN_BINARY="$APP/Contents/MacOS/stable"
[[ -x "$MAIN_BINARY" ]] || fail "bundle omitted its stable executable"
if [[ "${REQUIRE_UNIVERSAL:-1}" == "1" ]]; then
  lipo "$MAIN_BINARY" -verify_arch x86_64 arm64 >/dev/null \
    || fail "public release is not universal (x86_64 + arm64)"
fi

for file in \
  "$APP/Contents/Resources/agent-resume/install.sh" \
  "$APP/Contents/Resources/agent-resume/agent-json" \
  "$APP/Contents/Resources/agent-resume/agent-json.js" \
  "$APP/Contents/Resources/bin/clinch_agent_resume_launch" \
  "$APP/Contents/Resources/bin/warp_agent_resume_launch" \
  "$APP/Contents/Resources/update/clinch-update-public-key.json" \
  "$APP/Contents/Resources/update/clinch-update-helper" \
  "$APP/Contents/Resources/update/clinch-update-authorizer.applescript"; do
  [[ -f "$file" ]] || fail "bundle omitted ${file#"$APP/"}"
done
[[ -x "$APP/Contents/Resources/agent-resume/install.sh" ]] \
  || fail "bundled installer is not executable"
[[ -x "$APP/Contents/Resources/bin/clinch_agent_resume_launch" ]] \
  || fail "bundled resume launcher is not executable"

expected="$(awk 'NF { print $1; exit }' "$SHA_FILE" | tr 'A-F' 'a-f')"
actual="$(shasum -a 256 "$ZIP" | awk '{ print $1 }')"
[[ "$expected" == "$actual" ]] || fail "zip checksum sidecar does not match"

./script/clinch-update-manifest verify "$MANIFEST" "$SIGNATURE" \
  resources/update/clinch-update-public-key.json || fail "update manifest signature is invalid"
/usr/bin/python3 - "$MANIFEST" "$ZIP" "$VERSION" "$UPDATE_SEQUENCE" <<'PY' || exit 1
import hashlib, json, pathlib, sys
manifest = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
archive = pathlib.Path(sys.argv[2])
expected = {
    "schema_version": 1,
    "version": sys.argv[3],
    "sequence": int(sys.argv[4]),
    "bundle_id": "sh.clinch.Clinch",
}
for key, value in expected.items():
    if manifest.get(key) != value:
        raise SystemExit(f"release verification failed: manifest {key} mismatch")
if manifest.get("archive", {}).get("name") != "Clinch.app.zip":
    raise SystemExit("release verification failed: unexpected manifest archive name")
if manifest["archive"].get("size") != archive.stat().st_size:
    raise SystemExit("release verification failed: manifest archive size mismatch")
digest = hashlib.sha256(archive.read_bytes()).hexdigest()
if manifest["archive"].get("sha256") != digest:
    raise SystemExit("release verification failed: manifest archive hash mismatch")
PY

TMP="$(mktemp -d -t clinch-release-verify)"
trap 'rm -rf "$TMP"' EXIT
ditto -x -k "$ZIP" "$TMP/unzipped"
ZIPPED_APP="$TMP/unzipped/Clinch.app"
[[ -d "$ZIPPED_APP" ]] || fail "zip does not contain Clinch.app at its root"
codesign --verify --deep --strict "$ZIPPED_APP" \
  || fail "zip round-trip invalidated the app signature"
if [[ "${REQUIRE_UNIVERSAL:-1}" == "1" ]]; then
  lipo "$ZIPPED_APP/Contents/MacOS/stable" -verify_arch x86_64 arm64 >/dev/null \
    || fail "zip round-trip lost a required architecture"
fi

# Exercise the same clean-account setup users receive, with no third-party tools on PATH.
mkdir -p "$TMP/home"
HOME="$TMP/home" PATH="/usr/bin:/bin" \
  /bin/bash "$ZIPPED_APP/Contents/Resources/agent-resume/install.sh" --quiet
[[ -f "$TMP/home/.claude/settings.json" ]] || fail "first-run Claude setup did not land"
[[ -f "$TMP/home/.codex/config.toml" ]] || fail "first-run Codex setup did not land"

hdiutil verify "$DMG" >/dev/null || fail "DMG verification failed"

if [[ "${REQUIRE_NOTARIZATION:-0}" == "1" ]]; then
  spctl --assess --type execute --verbose=2 "$APP" \
    || fail "Gatekeeper rejected the app"
  xcrun stapler validate "$DMG" \
    || fail "DMG has no valid stapled notarization ticket"
fi

echo "✓ Release artifacts verified for $VERSION"
