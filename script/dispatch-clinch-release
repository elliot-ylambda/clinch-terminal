#!/usr/bin/env bash
# Builds, verifies, signs, remotely re-verifies, and publishes a release locally.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

REPO="${CLINCH_REPO:-elliot-ylambda/clinch-terminal}"
REMOTE="${CLINCH_REMOTE:-clinch}"
REQUESTED_VERSION="${VERSION:-}"
AUTO_VERSION="${CLINCH_AUTO_VERSION:-0}"
UPDATE_KEY="${CLINCH_UPDATE_SIGNING_KEY:-$HOME/.config/clinch/update-signing-key.pem}"
RELEASE_KEY="${CLINCH_RELEASE_SIGNING_KEY:-$HOME/.config/clinch/release-signing-key}"
ALLOWED_SIGNERS="$ROOT/resources/release/clinch-release-allowed-signers"
MINIMUM_FREE_KIB=$((40 * 1024 * 1024))
GH_RETRY_ATTEMPTS="${CLINCH_GH_RETRY_ATTEMPTS:-12}"
GH_RETRY_DELAY_SECONDS="${CLINCH_GH_RETRY_DELAY_SECONDS:-5}"
ISOLATED_WORKTREE="${CLINCH_RELEASE_ISOLATED_WORKTREE:-0}"
PINNED_COMMIT="${CLINCH_RELEASE_PINNED_COMMIT:-}"
RESUME_ENABLED="${CLINCH_RELEASE_RESUME:-1}"

publish_tmp=
RESUME_DIR=
RESUME_STATE=
RESUME_PHASE=
RELEASE_STARTED_AT=
UPDATE_SEQUENCE=

fail() {
  echo "local release failed: $*" >&2
  exit 1
}

ensure_blocking_stdin() {
  /usr/bin/python3 -c '
import fcntl
import os

flags = fcntl.fcntl(0, fcntl.F_GETFL)
fcntl.fcntl(0, fcntl.F_SETFL, flags & ~os.O_NONBLOCK)
' || fail "could not restore blocking terminal input"
}

on_exit() {
  local status=$?
  trap - EXIT
  [[ -z "$publish_tmp" ]] || rm -rf "$publish_tmp" || true
  return "$status"
}
trap on_exit EXIT

validate_version() {
  [[ "$1" =~ ^v[0-9]+(\.[0-9]+)+$ ]]
}

version_is_newer() {
  local left="${1#v}" right="${2#v}" width index left_part right_part
  local -a left_parts right_parts
  IFS=. read -r -a left_parts <<< "$left"
  IFS=. read -r -a right_parts <<< "$right"
  width="${#left_parts[@]}"
  if (( ${#right_parts[@]} > width )); then
    width="${#right_parts[@]}"
  fi
  for ((index = 0; index < width; index++)); do
    left_part="${left_parts[index]:-0}"
    right_part="${right_parts[index]:-0}"
    left_part=$((10#$left_part))
    right_part=$((10#$right_part))
    (( left_part > right_part )) && return 0
    (( left_part < right_part )) && return 1
  done
  return 1
}

increment_version() {
  local version="$1" prefix last
  prefix="${version%.*}"
  last="${version##*.}"
  printf '%s.%s\n' "$prefix" "$((10#$last + 1))"
}

load_resume_state() {
  local state_commit state_version state_sequence state_started_at state_phase
  [[ "$RESUME_ENABLED" == 1 && -f "$RESUME_STATE" ]] || return 1

  state_commit="$(jq -er '.commit | strings' "$RESUME_STATE")" || return 1
  state_version="$(jq -er '.version | strings' "$RESUME_STATE")" || return 1
  state_sequence="$(jq -er '.sequence | numbers' "$RESUME_STATE")" || return 1
  state_started_at="$(jq -er '.release_started_at | strings' "$RESUME_STATE")" || return 1
  state_phase="$(jq -er '.phase | strings' "$RESUME_STATE")" || return 1

  [[ "$state_commit" == "$COMMIT_SHA" ]] || return 1
  validate_version "$state_version" || return 1
  [[ "$state_sequence" =~ ^[0-9]+$ && "$state_sequence" -gt 0 ]] || return 1
  [[ "$state_started_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] \
    || return 1
  case "$state_phase" in
    initialized|candidate_verified|stage_verified) ;;
    *) return 1 ;;
  esac

  if [[ "$AUTO_VERSION" == 0 && -n "$REQUESTED_VERSION" \
      && "$REQUESTED_VERSION" != "$state_version" ]]; then
    echo "Ignoring resumable release $state_version because explicit version $REQUESTED_VERSION was requested."
    return 1
  fi

  REQUESTED_VERSION="$state_version"
  UPDATE_SEQUENCE="$state_sequence"
  RELEASE_STARTED_AT="$state_started_at"
  RESUME_PHASE="$state_phase"
  echo "==> Resuming $REQUESTED_VERSION for ${COMMIT_SHA:0:12} from phase $RESUME_PHASE"
}

write_resume_state() {
  local phase="$1" tmp
  mkdir -p "$RESUME_DIR"
  tmp="$(mktemp "$RESUME_DIR/state.json.tmp.XXXXXX")"
  jq -n \
    --arg commit "$COMMIT_SHA" \
    --arg version "$REQUESTED_VERSION" \
    --argjson sequence "$UPDATE_SEQUENCE" \
    --arg release_started_at "$RELEASE_STARTED_AT" \
    --arg phase "$phase" \
    '{schema: 1, commit: $commit, version: $version, sequence: $sequence,
      release_started_at: $release_started_at, phase: $phase}' > "$tmp"
  mv "$tmp" "$RESUME_STATE"
  RESUME_PHASE="$phase"
}

clear_resume_state() {
  [[ -n "$RESUME_STATE" ]] || return 0
  rm -f "$RESUME_STATE"
  rmdir "$RESUME_DIR" >/dev/null 2>&1 || true
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required${2:+ ($2)}"
}

gh_error_is_transient() {
  grep -Eiq \
    'HTTP (408|429|5[0-9]{2})|server is currently available|temporar(il)?y unavailable|timed? out|timeout|connection (reset|refused)|TLS handshake|unexpected EOF' \
    "$1"
}

gh_with_retry() {
  local attempt=1 status stdout_file stderr_file
  stdout_file="$(mktemp "${TMPDIR:-/tmp}/clinch-gh-stdout.XXXXXX")"
  stderr_file="$(mktemp "${TMPDIR:-/tmp}/clinch-gh-stderr.XXXXXX")"

  while true; do
    : > "$stdout_file"
    : > "$stderr_file"
    if gh "$@" > "$stdout_file" 2> "$stderr_file"; then
      cat "$stdout_file"
      cat "$stderr_file" >&2
      rm -f "$stdout_file" "$stderr_file"
      return 0
    else
      status=$?
    fi

    if grep -Eiq \
      'HTTP 404|"status"[[:space:]]*:[[:space:]]*"?404"?|^release not found$' \
      "$stderr_file"; then
      rm -f "$stdout_file" "$stderr_file"
      return 44
    fi

    cat "$stdout_file" >&2
    cat "$stderr_file" >&2
    if (( attempt >= GH_RETRY_ATTEMPTS )) || ! gh_error_is_transient "$stderr_file"; then
      rm -f "$stdout_file" "$stderr_file"
      return "$status"
    fi

    echo "GitHub request failed transiently (attempt $attempt/$GH_RETRY_ATTEMPTS); retrying…" >&2
    sleep "$GH_RETRY_DELAY_SECONDS"
    ((attempt += 1))
  done
}

verify_release_key() {
  local actual expected
  actual="$(ssh-keygen -y -f "$RELEASE_KEY" | awk '{print $1, $2}')" \
    || fail "could not read the release signing key"
  expected="$(awk 'NF {print $2, $3; exit}' "$ALLOWED_SIGNERS")"
  [[ "$actual" == "$expected" ]] \
    || fail "release signing key does not match the committed trust root"
}

verify_source_state() {
  local expected_commit="$1" remote_main checkout_branch
  checkout_branch="$(git rev-parse --abbrev-ref HEAD)"
  if [[ "$ISOLATED_WORKTREE" == 1 ]]; then
    [[ "$checkout_branch" == HEAD ]] \
      || fail "isolated release checkout is not detached at its pinned commit"
  else
    [[ "$checkout_branch" == main ]] || fail "release checkout is not on main"
  fi
  [[ -z "$(git status --porcelain)" ]] || fail "release checkout is dirty"
  [[ "$(git rev-parse HEAD)" == "$expected_commit" ]] || fail "release source commit changed"
  [[ "$(git rev-parse "$REMOTE/main")" == "$expected_commit" ]] \
    || fail "local main no longer matches $REMOTE/main"
  remote_main="$(git ls-remote "$REMOTE" refs/heads/main | awk 'NF {print $1; exit}')"
  [[ "$remote_main" == "$expected_commit" ]] \
    || fail "$REMOTE/main changed during the local release"
}

confirm_publication() {
  local version="$1" commit="$2" expected response
  expected="PUBLISH $version ${commit:0:12}"
  [[ -t 0 ]] || fail "publication requires an interactive terminal"
  cat <<EOF

The complete local gate, universal artifact verification, SBOM, provenance, and signatures passed.
No public release exists yet. The next step creates or refreshes a signed tag and private draft,
downloads and verifies every uploaded asset, then publishes that release immediately.

Type exactly: $expected
EOF
  ensure_blocking_stdin
  read -r response
  [[ "$response" == "$expected" ]] || fail "publication was not confirmed"
}

ensure_signed_remote_tag() {
  local version="$1" commit="$2"
  if git ls-remote --exit-code --tags "$REMOTE" "refs/tags/$version" >/dev/null 2>&1; then
    git fetch --force "$REMOTE" "refs/tags/$version:refs/tags/$version"
  elif git rev-parse -q --verify "refs/tags/$version" >/dev/null 2>&1; then
    :
  else
    git \
      -c user.name="Clinch local release" \
      -c user.email="releases@clinch.sh" \
      -c gpg.format=ssh \
      -c user.signingkey="$RELEASE_KEY" \
      tag -s -a "$version" -m "Clinch $version public preview" "$commit"
  fi
  git -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$ALLOWED_SIGNERS" \
    verify-tag "$version"
  [[ "$(git rev-list -n 1 "$version")" == "$commit" ]] \
    || fail "tag $version points to another commit"
  if ! git ls-remote --exit-code --tags "$REMOTE" "refs/tags/$version" >/dev/null 2>&1; then
    git push "$REMOTE" "refs/tags/$version"
  fi
}

get_release_json() {
  local version="$1" response status
  if response="$(gh_with_retry release view "$version" --repo "$REPO" \
      --json databaseId,tagName,isDraft,name,body,targetCommitish,assets)"; then
    :
  else
    status=$?
    return "$status"
  fi
  jq -e --arg version "$version" '
        select(.tagName == $version)
        | {
            id: .databaseId,
            tag_name: .tagName,
            draft: .isDraft,
            name,
            body,
            target_commitish: .targetCommitish,
            assets: [.assets[] | {
              id,
              name,
              size,
              updated_at: .updatedAt,
              digest
            }]
          }
      ' <<< "$response"
}

verify_asset_name_set() {
  local version="$1" dist="$2" allow_missing="$3" release_json local_names remote_names extra
  release_json="$(get_release_json "$version")" \
    || fail "could not inspect draft release $version"
  local_names="$(find "$dist" -mindepth 1 -maxdepth 1 -print \
    | sed 's#^.*/##' | LC_ALL=C sort)"
  remote_names="$(jq -r '.assets[].name' <<< "$release_json" | LC_ALL=C sort)"
  extra="$(comm -13 <(printf '%s\n' "$local_names") <(printf '%s\n' "$remote_names"))"
  [[ -z "$extra" ]] || fail "draft release contains unexpected assets: ${extra//$'\n'/, }"
  if [[ "$allow_missing" != true ]]; then
    [[ "$local_names" == "$remote_names" ]] || fail "draft release asset set is incomplete"
  fi
}

stage_private_draft() {
  local version="$1" commit="$2" stage="$3" dist release_json release_status
  dist="$stage/dist"
  if release_json="$(get_release_json "$version")"; then
    :
  else
    release_status=$?
    [[ "$release_status" == 44 ]] \
      || fail "could not inspect existing release $version"
    if ! gh_with_retry release create "$version" \
      --repo "$REPO" \
      --verify-tag \
      --target "$commit" \
      --draft \
      --latest=false \
      --title "Clinch $version" \
      --notes-file "$stage/release-notes.md"; then
      release_json="$(get_release_json "$version")" \
        || fail "could not reconcile draft creation for $version"
    fi
  fi

  release_json="$(get_release_json "$version")" \
    || fail "could not inspect draft release $version"
  [[ "$(jq -r .draft <<< "$release_json")" == true ]] \
    || fail "release $version already exists and is not a private draft"
  verify_asset_name_set "$version" "$dist" true
  gh_with_retry release edit "$version" --repo "$REPO" --draft --latest=false \
    --title "Clinch $version" --notes-file "$stage/release-notes.md" >/dev/null \
    || fail "could not refresh private draft $version"
  gh_with_retry release upload "$version" "$dist"/* --repo "$REPO" --clobber \
    || fail "could not upload private draft assets for $version"
  verify_asset_name_set "$version" "$dist" false
}

snapshot_private_draft() {
  local version="$1" output="$2" release_json
  release_json="$(get_release_json "$version")" \
    || fail "could not inspect private draft $version"
  [[ "$(jq -r .draft <<< "$release_json")" == true ]] \
    || fail "release $version is no longer a private draft"
  [[ "$(jq -r .tag_name <<< "$release_json")" == "$version" ]] \
    || fail "private draft tag changed"
  jq -S '{id,tag_name,draft,name,body,target_commitish,assets:([.assets[] |
    {id,name,size,updated_at,digest}] | sort_by(.name))}' <<< "$release_json" > "$output"
}

verify_remote_tag() {
  local version="$1" commit="$2" remote_tag local_tag
  git -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$ALLOWED_SIGNERS" \
    verify-tag "$version"
  [[ "$(git rev-list -n 1 "$version")" == "$commit" ]] \
    || fail "tag $version stopped pointing to $commit"
  remote_tag="$(git ls-remote --tags "$REMOTE" "refs/tags/$version" \
    | awk 'NF {print $1; exit}')"
  local_tag="$(git rev-parse "refs/tags/$version")"
  [[ -n "$remote_tag" && "$remote_tag" == "$local_tag" ]] \
    || fail "signed tag $version changed after verification"
}

publish_verified_draft() {
  local version="$1" commit="$2" sequence="$3"
  local before_download after_download before_publish release_json

  publish_tmp="$(mktemp -d "${TMPDIR:-/tmp}/clinch-release-publish.XXXXXX")"
  mkdir -p "$publish_tmp/dist"
  before_download="$publish_tmp/draft-before-download.json"
  after_download="$publish_tmp/draft-after-download.json"
  before_publish="$publish_tmp/draft-before-publish.json"

  echo "==> Downloading and independently verifying the private draft"
  snapshot_private_draft "$version" "$before_download"
  gh_with_retry release download "$version" --repo "$REPO" \
    --dir "$publish_tmp/dist" --clobber \
    || fail "could not download private draft assets for $version"
  snapshot_private_draft "$version" "$after_download"
  cmp "$before_download" "$after_download" \
    || fail "private draft changed while its assets were downloading"
  ./script/verify-clinch-release-stage "$publish_tmp/dist" "$version" "$commit" "$sequence"

  CLINCH_REPO="$REPO" \
  CLINCH_ALLOW_NO_PREVIOUS_RELEASE="$ALLOW_NO_PREVIOUS_RELEASE" \
    ./script/next-clinch-update-sequence verify "$version" "$sequence"
  verify_source_state "$commit"
  verify_remote_tag "$version" "$commit"
  snapshot_private_draft "$version" "$before_publish"
  cmp "$after_download" "$before_publish" \
    || fail "private draft changed after cryptographic verification"

  echo "==> Publishing the verified draft"
  if ! gh_with_retry release edit "$version" --repo "$REPO" \
      --draft=false --latest >/dev/null; then
    release_json="$(get_release_json "$version")" \
      || fail "GitHub rejected final release publication; inspect the draft before retrying"
    [[ "$(jq -r .draft <<< "$release_json")" == false ]] \
      || fail "GitHub rejected final release publication; inspect the draft before retrying"
  fi
  release_json="$(get_release_json "$version")" \
    || fail "could not verify final release publication"
  [[ "$(jq -r .draft <<< "$release_json")" == false ]] \
    || fail "release remained a private draft after publication"
  rm -rf "$publish_tmp" || true
  publish_tmp=
}

for command in gh git make cargo cargo-nextest cargo-deny cargo-bundle cargo-about syft jq curl \
    ssh-keygen shasum hdiutil cmp node corepack; do
  require_command "$command" "see README release prerequisites"
done
[[ -x /usr/bin/python3 ]] || fail "/usr/bin/python3 is required"
[[ "$REPO" == elliot-ylambda/clinch-terminal ]] \
  || fail "authenticated artifacts are fixed to elliot-ylambda/clinch-terminal"
[[ "$AUTO_VERSION" == 0 || "$AUTO_VERSION" == 1 ]] \
  || fail "CLINCH_AUTO_VERSION must be 0 or 1"
[[ "$ISOLATED_WORKTREE" == 0 || "$ISOLATED_WORKTREE" == 1 ]] \
  || fail "CLINCH_RELEASE_ISOLATED_WORKTREE must be 0 or 1"
[[ "$RESUME_ENABLED" == 0 || "$RESUME_ENABLED" == 1 ]] \
  || fail "CLINCH_RELEASE_RESUME must be 0 or 1"
[[ "$GH_RETRY_ATTEMPTS" =~ ^[1-9][0-9]*$ ]] \
  || fail "CLINCH_GH_RETRY_ATTEMPTS must be a positive integer"
[[ "$GH_RETRY_DELAY_SECONDS" =~ ^[0-9]+$ ]] \
  || fail "CLINCH_GH_RETRY_DELAY_SECONDS must be a nonnegative integer"
[[ -f "$UPDATE_KEY" ]] || fail "missing update signing key $UPDATE_KEY"
[[ -f "$RELEASE_KEY" ]] || fail "missing release signing key $RELEASE_KEY"
./script/clinch-update-manifest verify-key \
  "$UPDATE_KEY" "$ROOT/resources/update/clinch-update-public-key.json" >/dev/null \
  || fail "update signing key preflight failed"
verify_release_key
gh auth status >/dev/null || fail "authenticate gh before releasing"
git remote get-url "$REMOTE" >/dev/null || fail "missing Git remote $REMOTE"
available_kib="$(df -Pk "$ROOT" | awk 'NR == 2 {print $4}')"
[[ "$available_kib" =~ ^[0-9]+$ ]] || fail "could not determine free disk space"
(( available_kib >= MINIMUM_FREE_KIB )) \
  || fail "at least 40 GiB of free disk space is required for a universal local release"

if [[ "$ISOLATED_WORKTREE" == 1 ]]; then
  [[ "$PINNED_COMMIT" =~ ^[0-9a-f]{40}$ ]] \
    || fail "isolated release is missing a valid pinned commit"
  COMMIT_SHA="$(git rev-parse HEAD)"
  [[ "$COMMIT_SHA" == "$PINNED_COMMIT" ]] \
    || fail "isolated release checkout does not match its pinned commit"
else
  ./script/require-latest-main
  COMMIT_SHA="$(git rev-parse HEAD)"
fi
verify_source_state "$COMMIT_SHA"
RESUME_DIR="target/release-resume/$COMMIT_SHA"
RESUME_STATE="$RESUME_DIR/state.json"
load_resume_state || RESUME_PHASE=

latest_release_version="$(
  gh_with_retry api "repos/$REPO/releases?per_page=100" \
    --jq '[.[] | select(.draft == false and .prerelease == false)][0].tag_name // empty'
)" || fail "could not inspect existing releases"
ALLOW_NO_PREVIOUS_RELEASE=0
if [[ -n "$latest_release_version" ]]; then
  validate_version "$latest_release_version" \
    || fail "latest release has invalid version '$latest_release_version'"
else
  ALLOW_NO_PREVIOUS_RELEASE=1
fi

# A deleted immutable release leaves its tag permanently reserved. Compare the
# requested version with every numeric remote tag as well as the latest release
# so a cleanup/bootstrap release can never attempt to reuse or move one.
remote_versions="$(
  git ls-remote --tags --refs "$REMOTE" 'refs/tags/v*' \
    | awk '$2 ~ /^refs\/tags\/v/ {sub("^refs/tags/", "", $2); print $2}'
)" || fail "could not inspect remote release tags"
latest_version="$latest_release_version"
while IFS= read -r remote_version; do
  [[ -n "$remote_version" ]] || continue
  validate_version "$remote_version" || continue
  if [[ -z "$latest_version" ]] || version_is_newer "$remote_version" "$latest_version"; then
    latest_version="$remote_version"
  fi
done <<< "$remote_versions"

if [[ -z "$RESUME_PHASE" ]]; then
  if [[ -z "$REQUESTED_VERSION" || "$REQUESTED_VERSION" == auto ]]; then
    REQUESTED_VERSION="v0.$(date -u +%Y.%m.%d.%H%M)"
    AUTO_VERSION=1
  fi
  validate_version "$REQUESTED_VERSION" || fail "invalid version '$REQUESTED_VERSION'"
  if [[ -n "$latest_version" ]] && ! version_is_newer "$REQUESTED_VERSION" "$latest_version"; then
    if [[ "$AUTO_VERSION" == 1 ]]; then
      REQUESTED_VERSION="$(increment_version "$latest_version")"
    else
      fail "requested version $REQUESTED_VERSION is not newer than $latest_version"
    fi
  fi
else
  validate_version "$REQUESTED_VERSION" || fail "resumable release has an invalid version"
  if [[ -n "$latest_version" && "$latest_version" != "$REQUESTED_VERSION" ]] \
      && version_is_newer "$latest_version" "$REQUESTED_VERSION"; then
    fail "a newer release or reserved tag ($latest_version) supersedes resumable $REQUESTED_VERSION"
  fi
fi

[[ -n "$RELEASE_STARTED_AT" ]] \
  || RELEASE_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
STAGE="target/release-stage/$REQUESTED_VERSION"
stage_ready=0
candidate_ready=0

if [[ "$RESUME_PHASE" == stage_verified ]]; then
  echo "==> Verifying commit-keyed staged assets before resuming publication"
  if ./script/verify-clinch-release-stage \
      "$STAGE/dist" "$REQUESTED_VERSION" "$COMMIT_SHA" "$UPDATE_SEQUENCE"; then
    stage_ready=1
  else
    echo "Cached staged assets are no longer valid; checking the verified candidate cache."
    RESUME_PHASE=candidate_verified
  fi
fi

if [[ "$stage_ready" == 0 && "$RESUME_PHASE" == candidate_verified ]]; then
  echo "==> Verifying commit-keyed candidate artifacts before resuming assembly"
  if make _verify-existing \
      VERSION="$REQUESTED_VERSION" \
      UPDATE_SEQUENCE="$UPDATE_SEQUENCE" \
      UNIVERSAL=1; then
    candidate_ready=1
  else
    echo "Cached candidate artifacts are no longer valid; rebuilding them."
    RESUME_PHASE=initialized
  fi
fi

if [[ "$stage_ready" == 0 && "$candidate_ready" == 0 ]]; then
  echo "==> Running the complete local release gate for ${COMMIT_SHA:0:12}"
  make release-check
  verify_source_state "$COMMIT_SHA"

  if [[ -z "$UPDATE_SEQUENCE" ]]; then
    echo "==> Deriving the authenticated update sequence"
    UPDATE_SEQUENCE="$(
      CLINCH_REPO="$REPO" \
      CLINCH_ALLOW_NO_PREVIOUS_RELEASE="$ALLOW_NO_PREVIOUS_RELEASE" \
        ./script/next-clinch-update-sequence
    )"
    [[ "$UPDATE_SEQUENCE" =~ ^[0-9]+$ && "$UPDATE_SEQUENCE" -gt 0 ]] \
      || fail "sequence helper returned an invalid value"
  fi
  write_resume_state initialized

  echo "==> Building and verifying the universal release candidate"
  make _verify \
    VERSION="$REQUESTED_VERSION" \
    UPDATE_SEQUENCE="$UPDATE_SEQUENCE" \
    UNIVERSAL=1 \
    CLINCH_UPDATE_SIGNING_KEY="$UPDATE_KEY" \
    CLINCH_RELEASE_SIGNING_KEY="$RELEASE_KEY"
  verify_source_state "$COMMIT_SHA"
  write_resume_state candidate_verified
  candidate_ready=1
fi

if [[ "$stage_ready" == 0 ]]; then
  echo "==> Assembling signed local release provenance and draft assets"
  CLINCH_RELEASE_SIGNING_KEY="$RELEASE_KEY" \
  CLINCH_RELEASE_STARTED_AT="$RELEASE_STARTED_AT" \
  ./script/assemble-clinch-release-stage \
    "$REQUESTED_VERSION" "$COMMIT_SHA" "$UPDATE_SEQUENCE"
  ./script/verify-clinch-release-stage \
    "$STAGE/dist" "$REQUESTED_VERSION" "$COMMIT_SHA" "$UPDATE_SEQUENCE"
  verify_source_state "$COMMIT_SHA"
  write_resume_state stage_verified
fi

confirm_publication "$REQUESTED_VERSION" "$COMMIT_SHA"
verify_source_state "$COMMIT_SHA"
ensure_signed_remote_tag "$REQUESTED_VERSION" "$COMMIT_SHA"
stage_private_draft "$REQUESTED_VERSION" "$COMMIT_SHA" "$STAGE"
publish_verified_draft "$REQUESTED_VERSION" "$COMMIT_SHA" "$UPDATE_SEQUENCE"
clear_resume_state

trap - EXIT
echo "✓ Locally built, verified, signed, and published $REQUESTED_VERSION."
echo "Release: https://github.com/$REPO/releases/tag/$REQUESTED_VERSION"
