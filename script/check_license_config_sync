#!/usr/bin/env bash
#
# Verifies that the accepted license lists in deny.toml and about.toml are in
# sync. Exits non-zero with a diff if they diverge.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

python3 -c "
import pathlib, re, sys

def string_array(path, key, section=None):
    text = pathlib.Path(path).read_text(encoding='utf-8')
    if section is not None:
        match = re.search(
            rf'(?ms)^\\[{re.escape(section)}\\]\\s*(.*?)(?=^\\[|\\Z)', text
        )
        if match is None:
            raise SystemExit(f'missing [{section}] in {path}')
        text = match.group(1)
    match = re.search(rf'(?ms)^{re.escape(key)}\\s*=\\s*\\[(.*?)^\\]', text)
    if match is None:
        raise SystemExit(f'missing {key} array in {path}')
    return set(re.findall(r'\"([^\"]+)\"', match.group(1)))

deny = string_array('$REPO_ROOT/deny.toml', 'allow', 'licenses')
about = string_array('$REPO_ROOT/about.toml', 'accepted')

if deny != about:
    only_deny = deny - about
    only_about = about - deny
    if only_deny:
        print(f'In deny.toml but not about.toml: {sorted(only_deny)}')
    if only_about:
        print(f'In about.toml but not deny.toml: {sorted(only_about)}')
    sys.exit(1)

print('License config in sync.')
"
