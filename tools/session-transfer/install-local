#!/usr/bin/env python3
"""Install a versioned helper without modifying a signed Clinch app bundle."""

import hashlib
import json
import os
import shutil
import tempfile
from pathlib import Path

source = Path(__file__).resolve().parent
names = (
    "clinch-sessions",
    "session_cli.py",
    "session_inventory.py",
    "session_worker.py",
    "session_handoff.py",
)
version = hashlib.sha256(
    b"".join((source / name).read_bytes() for name in names)
).hexdigest()[:20]
root = (Path.home() / ".local/share/clinch/session-transfer").resolve()
current = root / "current"
command = Path.home() / ".local/bin/clinch-sessions"
destination = root / "versions" / version
if (command.exists() or command.is_symlink()) and (
    not command.is_symlink() or os.readlink(command) != str(current / "clinch-sessions")
):
    raise SystemExit(
        "An unrelated clinch-sessions command already exists; leave it in place and choose a different installation path."
    )
if (current.exists() or current.is_symlink()) and (
    not current.is_symlink() or current.resolve().parent != root / "versions"
):
    raise SystemExit("An unrelated installation exists at " + str(current))
destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
if not destination.exists():
    stage = Path(tempfile.mkdtemp(prefix="install-", dir=destination.parent))
    try:
        for name in names:
            shutil.copyfile(source / name, stage / name)
            (stage / name).chmod(0o700 if name == "clinch-sessions" else 0o600)
        stage.rename(destination)
    finally:
        if stage.exists():
            shutil.rmtree(stage)
link = root / ("current-" + version + ".tmp")
try:
    link.symlink_to(destination)
    link.replace(current)
finally:
    link.unlink(missing_ok=True)
command.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
if not command.is_symlink():
    command.symlink_to(current / "clinch-sessions")
print(
    json.dumps(
        {"command": str(command), "version": version, "installed": str(destination)},
        indent=2,
    )
)
