crates/command-signatures-v2/js/build
crates/command-signatures-v2/js/node_modules

# For testing changes to the channel versions file
channel_versions_test.json

# Don't include any profiling output by accident.
profile.pb
*.mm_profdata
chrome_profiler.json

# Don't include any files that we write for testing purposes.
crates/warp_files/test_data/test_write

# Don't include fonts downloaded by the script used to generate font fallback code.
script/font_fallback/downloaded_fonts

# Don't include the generated Windows installer
script/windows/Output
.aider*

# temporary vim files. Source: https://github.com/github/gitignore/blob/main/Global/Vim.gitignore
*~
[._]*.s[a-v][a-z]
!*.svg # keep svg files
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Don't include the PTY recording.
warp.pty.recording

# Don't include captured frames generated locally.
frame_capture_*.png

# Don't include history file generated by migrations
app/src/persistence/schema.rs.orig

# Local AI assistants, editor state, and private planning material
**/.agents/
**/.claude/
**/.codex/
**/.cursor/
**/.mcp.json
**/.remember/
**/.superpowers/
**/.warp/
**/.warpindexingignore

# The bundled Codex marketplace uses the provider-required `.agents` layout;
# unlike personal agent state, this manifest is a shipped application resource.
!resources/bundled/agent-plugins/codex-warp/.agents/
!resources/bundled/agent-plugins/codex-warp/.agents/plugins/
!resources/bundled/agent-plugins/codex-warp/.agents/plugins/marketplace.json
**/.vscode/
AGENTS.md
CLAUDE.md
WARP.md
/docs/
/skills-lock.json

# Generated duplicate of crates/command-signatures-v2
/command-signatures-v2/

# Internal agent development environment
/docker/agent-dev/

# Don't include ctags output
tags

# Tab drag development notes
pr_cleanup.md
desired_behavior.md

# Don't include the python cache for bundled skills.
__pycache__/

# Project notes
.note/

# Agent session transcripts exported to the repo root. Kept locally, never
# committed: they contain raw prompts, unshipped design work, and local paths.
# Anchored to the root so bundled/test .txt fixtures are unaffected.
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
